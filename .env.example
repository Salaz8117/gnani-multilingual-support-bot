# Gnani AI API Configuration
# Get your API key from: https://gnani.ai/internship
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.gnani.ai/v1

# Optional: For local AI gateway (FreeLLMAPI/OmniRoute)
# GNANI_BASE_URL=http://localhost:3001/v1

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Audio Processing
MAX_AUDIO_SIZE_MB=25
SUPPORTED_AUDIO_FORMATS=wav,mp3,m4a,ogg,flac
SAMPLE_RATE=16000

# Prisma (STT) Settings
PRISMA_DEFAULT_LANGUAGE=auto
PRISMA_ENABLE_DIARIZATION=false
PRISMA_NOISE_REDUCTION=true

# Evon (Reasoning) Settings
EVON_MODEL=evon-30b
EVON_TEMPERATURE=0.3
EVON_MAX_TOKENS=1024
EVON_SYSTEM_PROMPT_PATH=assets/prompts/support_bot_system.txt

# Timbre (TTS) Settings
TIMBRE_DEFAULT_VOICE=female_warm
TIMBRE_DEFAULT_LANGUAGE=hi-IN
TIMBRE_SAMPLE_RATE=22050

# Demo Settings
DEMO_PORT=7860
API_PORT=8000

# Optional: Twilio for telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Redis for session caching
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# CORS allowed origins (comma-separated). Never use "*" together with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:7860